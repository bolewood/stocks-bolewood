{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stocks.bolewood.com/data/schema/wrapper.schema.json",
  "title": "AI wrapper record",
  "description": "Discriminated union on basis. Canonical enforcement is data/schema/validate.mjs. No generic value field; impliedExposure is computed only.",
  "type": "object",
  "required": [
    "schemaVersion",
    "methodologyVersion",
    "ticker",
    "yahooSymbol",
    "name",
    "wrapperType",
    "denominatorType",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "methodologyVersion": {
      "const": "1.2.0"
    },
    "wrapperType": {
      "enum": [
        "operating-company",
        "closed-end-fund",
        "interval-fund",
        "holding-company",
        "adr",
        "etf",
        "unknown"
      ]
    },
    "denominatorType": {
      "enum": [
        "market-cap",
        "adr-equivalent-market-cap",
        "total-net-assets",
        "unknown"
      ]
    },
    "holdingSecurity": {
      "enum": [
        "common",
        "preferred",
        "convertible",
        "spv-interest",
        "fund-interest",
        "mixed",
        "unknown"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "fields",
        "sourceClass",
        "measurementDate"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sourceClass": {
          "enum": [
            "primary",
            "secondary",
            "assumption"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accession": {
          "type": "string",
          "pattern": "^\\d{10}-\\d{2}-\\d{6}$"
        },
        "measurementDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "publicationDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": "string"
        },
        "estimationMethod": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "accession"
          ]
        }
      ]
    }
  }
}
